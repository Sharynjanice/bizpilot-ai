# --- Côté serveur uniquement (fonctions Vercel dans /api) ---
# Ne JAMAIS préfixer ces variables par VITE_ : elles seraient exposées au navigateur.
# URL de base de l'instance n8n, sans slash final (ex. https://n8n.mon-domaine.fr)
N8N_BASE_URL=
# Clé envoyée à n8n dans l'en-tête x-api-key
N8N_API_KEY=

# --- Côté navigateur ---
# true = données fictives, aucun appel réseau (développement)
VITE_USE_MOCK=true
